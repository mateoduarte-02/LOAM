<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧟  Modo Apocalipsis Zombie"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sección solo para el humor, no es un consejo real"
            android:textSize="12sp"
            android:textColor="@color/texto_secundario"
            android:layout_marginBottom="20dp" />

        <!-- Modo Bunker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/fondo_tarjeta"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏚️ Modo Bunker"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal" />

            <TextView
                android:id="@+id/tv_dias_bunker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Día 0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/primario"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tv_mensaje_bunker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/texto_secundario"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Plan de Escape -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/fondo_tarjeta"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎒 Plan de Escape"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/contenedor_checklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Traductor de gruñidos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/fondo_tarjeta"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗣️ Traductor de Gruñidos Zombie"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_texto_traducir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Escribí algo para traducir..."
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/btn_traducir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_boton_linterna"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Traducir texto"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— o dale el micrófono a un zombie —"
                android:textSize="12sp"
                android:textColor="@color/texto_secundario"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/btn_grabar_zombie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="@color/peligro"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tv_texto_boton_zombie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎙️  Grabar al zombie"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_resultado_traduccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="15sp"
                android:textStyle="italic"
                android:textColor="@color/primario"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_traduccion_final"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/texto_secundario" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>