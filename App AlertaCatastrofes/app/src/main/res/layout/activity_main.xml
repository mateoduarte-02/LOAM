<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/gradiente_header"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌪️"
                    android:textSize="26sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alerta Catástrofes"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu app de prevención y respuesta"
                android:textSize="13sp"
                android:textColor="#B9C9D6"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/fondo_chip"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_clima"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando clima..."
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Estado de batería: información directa, no botón -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/fondo_tarjeta"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋"
                    android:textSize="30sp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_bateria_porcentaje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />

                    <TextView
                        android:id="@+id/tv_bateria_restante"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculando tiempo restante..."
                        android:textSize="12sp"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/tv_bateria_hora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/texto_secundario" />
                </LinearLayout>
            </LinearLayout>

            <!-- Linterna: botón circular, minimalista -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/fondo_tarjeta"
                android:padding="18dp"
                android:elevation="4dp"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:id="@+id/btn_linterna"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/circulo_linterna_apagada"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="💡"
                        android:textSize="30sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modo Linterna"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />

                    <TextView
                        android:id="@+id/tv_estado_linterna_home"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tocá para activar el flash"
                        android:textSize="13sp"
                        android:textColor="@color/texto_secundario" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECCIÓN: Herramientas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Herramientas"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="10dp" />

            <!-- Fila: Emergencias + Ubicación -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:id="@+id/btn_emergencias"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_tarjeta"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/icono_circulo_rojo"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="📞"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergencias"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_ubicacion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_tarjeta"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/icono_circulo_rojo"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="📍"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Dónde estoy?"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fila: Video + Audio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:id="@+id/btn_video_home"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_tarjeta"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/icono_circulo_morado"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🎥"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grabar Video"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_audio_home"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_tarjeta"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/icono_circulo_morado"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🎙️"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grabar Audio"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Chat + Comando por voz -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/btn_chat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_tarjeta"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/icono_circulo_verde"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="💬"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chat Asistencia"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_voz"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_tarjeta"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/icono_circulo_verde"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🎤"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Comando Voz"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_resultado_voz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/texto_secundario"
                android:layout_marginTop="-14dp"
                android:layout_marginBottom="14dp" />

            <!-- SECCIÓN: Guía de Acción, directo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guía de Acción"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/btn_guia_terremoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/fondo_tarjeta"
                android:padding="14dp"
                android:elevation="2dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌍"
                    android:textSize="22sp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terremoto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_guia_inundacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/fondo_tarjeta"
                android:padding="14dp"
                android:elevation="2dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌊"
                    android:textSize="22sp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inundación"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_guia_incendio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/fondo_tarjeta"
                android:padding="14dp"
                android:elevation="2dp"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥"
                    android:textSize="22sp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incendio"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal" />
            </LinearLayout>

            <!-- SECCIÓN: Extras -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extras"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/btn_brujula"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_tarjeta"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/icono_circulo_verde"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🧭"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brújula"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_qr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_tarjeta"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/icono_circulo_morado"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🆔"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QR Emergencia"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECCIÓN: Simulación (solo demostración) -->
            <LinearLayout
                android:id="@+id/btn_simular_catastrofe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFEBEE"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨"
                    android:textSize="26sp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simular Catástrofe"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/peligro" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Solo modo de ejemplo, para ver cómo funciona la alarma"
                        android:textSize="11sp"
                        android:textColor="@color/peligro" />
                </LinearLayout>
            </LinearLayout>

            <!-- Modo Zombie: sección de humor -->
            <LinearLayout
                android:id="@+id/btn_zombie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/fondo_tarjeta"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧟"
                    android:textSize="26sp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modo Apocalipsis Zombie"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sección de humor, no te lo tomes en serio"
                        android:textSize="11sp"
                        android:textColor="@color/texto_secundario" />
                </LinearLayout>
            </LinearLayout>




        </LinearLayout>
    </LinearLayout>
</ScrollView>